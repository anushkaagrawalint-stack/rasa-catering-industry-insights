# Postgres (Neon / Vercel Postgres). Leave unset locally to use the embedded PGlite database in ./.data/pglite
DATABASE_URL=
# Vercel Blob. Leave unset locally to store uploads in ./.data/blob
BLOB_READ_WRITE_TOKEN=
# Sign-in accounts (JSON array). role "admin" can see and use /admin; "viewer" sees the dashboard only
APP_USERS=[{"email":"admin@example.com","password":"change-me","role":"admin"},{"email":"viewer@example.com","password":"change-me","role":"viewer"}]
# At least 32 random characters; signs the session cookies
SESSION_SECRET=replace-with-a-long-random-string-of-32-plus-chars
